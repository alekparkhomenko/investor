# Logging
LOG_LEVEL=info
LOG_AS_JSON=false

# Loki (optional — set LOKI_ENABLED=false to disable)
LOKI_ENABLED=false
LOKI_HOST=http://localhost:3100
LOKI_ENV=development

# MOEX stock tickers to track (comma-separated)
SYMBOLS=SBER,GAZP,MOEX

# Polling interval for MOEX API
POLL_INTERVAL=5s

# PostgreSQL
DATABASE_URL=postgres://investor:investor@localhost:5432/investor?sslmode=disable

# HTTP Server
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
