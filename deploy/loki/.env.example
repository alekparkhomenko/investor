# Loki Stack Configuration
# Copy this file to .env and customize for your environment

# =============================================================================
# TELEGRAM NOTIFICATIONS (Optional)
# =============================================================================
# To enable Telegram alerts:
# 1. Create a bot via @BotFather on Telegram
# 2. Add bot to your group/channel
# 3. Get the chat ID (see docs/loki-operations.md)

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# =============================================================================
# EMAIL NOTIFICATIONS (Optional)
# =============================================================================
# To enable email alerts, configure SMTP settings

GF_SMTP_ENABLED=false
GF_SMTP_HOST=
GF_SMTP_USER=
GF_SMTP_PASSWORD=
GF_SMTP_FROM_ADDRESS=grafana@example.com

# =============================================================================
# GRAFANA SETTINGS
# =============================================================================

GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

# =============================================================================
# LOKI SETTINGS
# =============================================================================

# Retention period (e.g., 168h = 7 days, 720h = 30 days)
LOKI_RETENTION_PERIOD=168h

# =============================================================================
# PROMTAIL SETTINGS
# =============================================================================

# Log paths to scrape (comma-separated)
PROMTAIL_LOG_PATHS=/var/log/*.log,/var/lib/docker/containers/*/*.log
