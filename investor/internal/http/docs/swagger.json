{
    "swagger": "2.0",
    "info": {
        "contact": {}
    },
    "paths": {
        "/api/v1/portfolio": {
            "get": {
                "description": "Get user's saved ticker portfolio",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "portfolio"
                ],
                "summary": "Get user's portfolio",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/model.Portfolio"
                        }
                    }
                }
            },
            "post": {
                "description": "Add tickers to user's portfolio",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "portfolio"
                ],
                "summary": "Add tickers to portfolio",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/model.AddTickersResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/portfolio/{ticker}": {
            "delete": {
                "description": "Remove a ticker from user's portfolio",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "portfolio"
                ],
                "summary": "Remove ticker from portfolio",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Ticker symbol",
                        "name": "ticker",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/model.RemoveTickerResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/tickers": {
            "get": {
                "description": "Get all available MOEX stock tickers",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "tickers"
                ],
                "summary": "List available MOEX tickers",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/model.TickersResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "model.AddTickersResponse": {
            "type": "object",
            "properties": {
                "added": {
                    "type": "integer"
                },
                "tickers": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            }
        },
        "model.Portfolio": {
            "type": "object",
            "properties": {
                "tickers": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "updated_at": {
                    "type": "string"
                }
            }
        },
        "model.RemoveTickerResponse": {
            "type": "object",
            "properties": {
                "removed": {
                    "type": "boolean"
                },
                "ticker": {
                    "type": "string"
                }
            }
        },
        "model.Ticker": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string"
                },
                "sector": {
                    "type": "string"
                },
                "symbol": {
                    "type": "string"
                }
            }
        },
        "model.TickersResponse": {
            "type": "object",
            "properties": {
                "tickers": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/model.Ticker"
                    }
                }
            }
        }
    }
}